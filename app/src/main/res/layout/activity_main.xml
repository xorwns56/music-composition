<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#3b577d"
        android:id="@+id/main"
        android:visibility="invisible">
        <com.xorwns56.music_composition_app.NoteLineImageView
            android:id="@+id/noteLineImageView"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginStart="100dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_above="@+id/mainBottom"
            android:layout_below="@+id/noteLineImageView">
            <com.xorwns56.music_composition_app.InstrumentImageView
                android:id="@+id/instrumentImageView"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:background="#3b577d"/>
            <com.xorwns56.music_composition_app.NoteTableImageView
                android:id="@+id/noteTableImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#f5ebeb"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/mainBottom"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:orientation="vertical"
            android:background="#3b577d">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <ImageButton
                    android:id="@+id/trackAddBtn"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:onClick="trackAddBtnClicked"
                    android:background="@drawable/blue_button"
                    android:layout_marginEnd="5dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:src="@drawable/plus"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageButton
                        android:id="@+id/moveHomeBtn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="moveHomeBtnClicked"
                        android:background="@drawable/blue_button"
                        android:layout_marginEnd="5dp"
                        android:padding="20dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:src="@drawable/home_arrow"/>
                    <ImageButton
                        android:id="@+id/moveLeftBtn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="moveLeftBtnClicked"
                        android:background="@drawable/blue_button"
                        android:layout_marginEnd="5dp"
                        android:padding="20dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:src="@drawable/left_arrow"/>
                    <ImageButton
                        android:id="@+id/moveRightBtn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="moveRightBtnClicked"
                        android:background="@drawable/blue_button"
                        android:layout_marginEnd="5dp"
                        android:padding="20dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:src="@drawable/right_arrow"/>
                    <ImageButton
                        android:id="@+id/moveEndBtn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:onClick="moveEndBtnClicked"
                        android:background="@drawable/blue_button"
                        android:layout_marginEnd="2dp"
                        android:padding="20dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:src="@drawable/end_arrow"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.75"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:padding="2dp"
                            android:background="@drawable/dark_blue_bg"
                            style="@style/ButtonText"
                            android:layout_marginEnd="5dp"
                            android:text="@string/unit"/>
                        <ImageButton
                            android:id="@+id/unitImageBtn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/text_bg"
                            android:scaleType="fitCenter"
                            android:padding="2dp"
                            android:adjustViewBounds="true"
                            android:onClick="unitImageBtnClicked"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp">
                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            style="@style/ButtonText"
                            android:padding="2dp"
                            android:text="@string/time_sig"
                            android:background="@drawable/dark_blue_bg"
                            android:layout_marginEnd="5dp"/>
                            <TextView
                                android:id="@+id/tempoOverText"
                                android:textColor="#000000"
                                android:textAlignment="center"
                                android:padding="2dp"
                                android:layout_width="0dp"
                                android:layout_weight="2"
                                android:layout_height="wrap_content"
                                android:background="@drawable/text_bg"
                                android:onClick="tempoOverTextClicked"/>
                            <TextView
                                android:textAlignment="center"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textColor="#f5ebeb"
                                android:text="@string/time_sig_bar"/>
                            <TextView
                                android:id="@+id/tempoUnderText"
                                android:textColor="#000000"
                                android:textAlignment="center"
                                android:padding="2dp"
                                android:layout_width="0dp"
                                android:layout_weight="2"
                                android:layout_height="wrap_content"
                                android:background="@drawable/text_bg"
                                android:onClick="tempoUnderTextClicked"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp">
                        <TextView
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:padding="2dp"
                            android:background="@drawable/dark_blue_bg"
                            style="@style/ButtonText"
                            android:layout_marginEnd="5dp"
                            android:text="@string/bpm"/>
                            <TextView
                                android:id="@+id/bpmText"
                                android:textAlignment="center"
                                android:textColor="#000000"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/text_bg"
                                android:padding="2dp"
                                android:onClick="bpmTextClicked"/>
                    </LinearLayout>
                </LinearLayout>
                <ImageButton
                    android:id="@+id/playBtn"
                    android:layout_width="0dp"
                    android:layout_weight="0.25"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/blue_button"
                    android:src="@drawable/play_btn"
                    android:onClick="playBtnClicked"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/footer_blue_button"
                android:layout_marginTop="5dp">
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/footer_blue_button"
                    android:src="@drawable/project"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:onClick="projectBtnClicked"/>
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/footer_blue_button"
                    android:src="@drawable/share"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:onClick="shareBtnClicked"/>
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/footer_blue_button"
                    android:src="@drawable/setting"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:onClick="settingBtnClicked"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>


    <LinearLayout
        android:id="@+id/slide"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="bottom"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:id="@+id/slideTop"
            android:clickable="true"
            android:focusable="true">
            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/footer_blue_button"
                style="@style/ButtonText"
                android:text="@string/copy"
                android:onClick="slideCopy"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/footer_blue_button"
                        style="@style/ButtonText"
                        android:text="@string/left"
                        android:layout_marginStart="5dp"
                        android:onClick="posLeftBtnClicked"/>
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/footer_blue_button"
                        style="@style/ButtonText"
                        android:text="@string/right"
                        android:onClick="posRightBtnClicked"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonText"
                    android:text="@string/pos"
                    android:textSize="12sp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/footer_blue_button"
                        style="@style/ButtonText"
                        android:layout_marginStart="5dp"
                        android:text="@string/minus"
                        android:onClick="sizeLeftBtnClicked"/>
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/footer_blue_button"
                        style="@style/ButtonText"
                        android:text="@string/plus"
                        android:onClick="sizeRightBtnClicked"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonText"
                    android:text="@string/size"
                    android:textSize="12sp"/>
            </FrameLayout>
            <Button
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/footer_blue_button"
                style="@style/ButtonText"
                android:text="@string/delete"
                android:layout_marginStart="5dp"
                android:onClick="slideRemove"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:id="@+id/slideBottom"
            android:orientation="vertical"
            android:background="@drawable/dark_blue_bg"
            android:padding="15dp"
            android:clickable="true"
            android:focusable="true">
            <!--Volume Start-->
            <com.xorwns56.music_composition_app.CustomVolumeBar
                android:id="@+id/volumeBar"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
            <!--Volume End-->
            <!--Drum Start-->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RadioGroup
                    android:id="@+id/drumGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>
            <!--Drum End-->
            <!--Pitch Start-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/relative"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            style="@style/ButtonText"
                            android:text="@string/octave"
                            android:background="@drawable/blue_track_title" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            style="@style/ButtonText"
                            android:text="@string/pitch"
                            android:background="@drawable/blue_track_title"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Button
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            style="@style/ButtonText"
                            android:onClick="relativePitch"
                            android:text="@string/minus"
                            android:background="@drawable/blue_track_title"
                            android:tag="-12"/>
                        <Button
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            style="@style/ButtonText"
                            android:onClick="relativePitch"
                            android:text="@string/plus"
                            android:background="@drawable/blue_track_title"
                            android:tag="12"/>
                        <Button
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            style="@style/ButtonText"
                            android:onClick="relativePitch"
                            android:text="@string/minus"
                            android:background="@drawable/blue_track_title"
                            android:tag="-1"
                            android:layout_marginStart="10dp"/>
                        <Button
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            style="@style/ButtonText"
                            android:onClick="relativePitch"
                            android:text="@string/plus"
                            android:background="@drawable/blue_track_title"
                            android:tag="1"/>
                    </LinearLayout>
                </LinearLayout>
                <RadioGroup
                    android:id="@+id/pitchGroup"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.5" />
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="1"
                            android:text="@string/c_sharp" />
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="3"
                            android:text="@string/d_sharp" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="6"
                            android:text="@string/f_sharp" />
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="8"
                            android:text="@string/g_sharp" />
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="10"
                            android:text="@string/a_sharp" />
                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.5" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="0"
                            android:text="@string/c" />
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="2"
                            android:text="@string/d" />
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="4"
                            android:text="@string/e"/>
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="5"
                            android:text="@string/f"/>
                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="7"
                            android:text="@string/g"/>

                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="9"
                            android:text="@string/a"/>

                        <RadioButton
                            style="@style/RadioButtonStyle"
                            android:textColor="@color/selected_text_color"
                            android:onClick="radioBtnAction"
                            android:tag="11"
                            android:text="@string/b" />
                    </LinearLayout>
                </RadioGroup>
                <com.xorwns56.music_composition_app.CustomOctaveBar
                    android:id="@+id/octaveBar"
                    android:layout_width="match_parent"
                    android:layout_marginTop="15dp"
                    android:layout_height="30dp"/>
            </LinearLayout>
            <!--Pitch End-->
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

